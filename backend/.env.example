# Copy to .env and fill in. Never commit .env.
PORT=5000
# MongoDB connection. In Railway, reference the MongoDB service's MONGO_URL.
MONGODB_URI=
MONGODB_DB_NAME=advocates_hub
# Railway private URL for the FastAPI chatbot service
CHATBOT_URL=
# Public React site URL for links in notification emails
FRONTEND_URL=http://localhost:3000
# Optional persistent location for advocate avatar uploads
APP_UPLOAD_DIR=
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Random secret used to sign login tokens (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
AUTH_SECRET=
# Admin console credentials. Generate the hash with: node setup-env.js admin@law4u.in "YourPassword"  (writes this whole file)
ADMIN_EMAIL=admin@law4u.in
ADMIN_PASSWORD_HASH=
# Admin registration notification recipient (Client & Advocate alerts)
ADMIN_NOTIFICATION_EMAIL=sandeepmasaguppi@gmail.com
# Railway Hobby/Free plans should use an HTTPS email API such as Resend.
# Verify the sender domain in Resend before setting RESEND_FROM.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM="Advocates Hub" <notifications@your-verified-domain.example>
# Gmail / Custom SMTP credentials for live email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sandeepmasaguppi@gmail.com
# Create a 16-character Google App Password under myaccount.google.com/apppasswords
SMTP_PASS=
SMTP_FROM="Advocates Hub" <advocatehub.in@gmail.com>
SMTP_REPLY_TO=advocatehub.in@gmail.com
